# Node / Next.js
node_modules/
**/node_modules/
.next/
**/.next/
out/
dist/
build/
coverage/
**/coverage/
.turbo/
**/*.tsbuildinfo

# Environment files and secrets (commit examples only)
.env
.env.*
!.env.example
!.env.sample
!.env.template
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# Private keys / credentials that must never be committed
*.pem
*.p12
*.pfx
*.key
id_rsa
id_rsa.*
credentials.json
**/service-account*.json

# Vercel local metadata
.vercel/
**/.vercel/

# Supabase local state / secrets (never commit)
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/**/start-secrets/
# Local CLI dump files if created outside .temp
supabase/.gitignore.local

# Logs and test outputs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
playwright-report/
test-results/
**/playwright-report/
**/test-results/

# Operating system / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
