# Node / Next.js
node_modules/
**/node_modules/
.next/
**/.next/
out/
dist/
build/
coverage/
**/coverage/
.turbo/
**/*.tsbuildinfo

# Environment files and secrets — never commit real values.
# Only empty templates (*.example / *.sample / *.template) may be tracked.
.env
.env.*
!.env.example
!.env.sample
!.env.template
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# Explicit local / deploy env copies (defense in depth; covered by .env.* above)
apps/web/.env.local
apps/web/.env.develop
apps/web/.env.example
apps/web/.env.staging
apps/web/.env.production
**/.env.local
**/.env.develop
**/.env.staging
**/.env.production

# Private keys / credentials that must never be committed
*.pem
*.p12
*.pfx
*.key
id_rsa
id_rsa.*
credentials.json
**/service-account*.json

# Vercel local metadata
.vercel/
**/.vercel/

# Supabase local state / secrets (never commit)
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/**/start-secrets/
# Local CLI dump files if created outside .temp
supabase/.gitignore.local

# Logs and test outputs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
playwright-report/
test-results/
**/playwright-report/
**/test-results/

# Operating system / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
