# Copy to apps/web/.env.local for local development (gitignored).
# Optional: apps/web/.env.develop for a linked develop project (also gitignored).
# Fill values from `supabase status` (local) or your non-production Supabase project.
# Never commit real keys. Never put SUPABASE_SECRET_KEY under NEXT_PUBLIC_*.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Apex domain for host-based routing (ADR-0002).
# Examples: ilmofahm.com | localhost
# Omit to keep path-based URLs: /school, /platform
# With localhost: admin.localhost:3000 and {slug}.localhost:3000
# NEXT_PUBLIC_ROOT_DOMAIN=

# Server-only privileged key. Optional until an admin path needs it.
# Do not expose this to the browser or Client Components.
# Put the real value only in .env.local or .env.develop — never here.
SUPABASE_SECRET_KEY=

# Server-only. Required for browser /platform/bootstrap.
# Generate a long random string (e.g. openssl rand -hex 32).
# Leave empty to disable web bootstrap — use ./scripts/bootstrap-platform-operator.sh instead.
# Never use NEXT_PUBLIC_ for this value.
PLATFORM_BOOTSTRAP_SECRET=
