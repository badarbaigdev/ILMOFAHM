# Copy to apps/web/.env.local for local development.
# Fill values from `supabase status` (local) or your non-production Supabase project.
# Never commit real keys. Never put SUPABASE_SECRET_KEY under NEXT_PUBLIC_*.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only privileged key. Optional until an admin path needs it.
# Do not expose this to the browser or Client Components.
SUPABASE_SECRET_KEY=
